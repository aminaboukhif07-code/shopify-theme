<section class="section">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">Activer mon compte</h1>
    {% form 'activate_customer_password' %}
      <div style="display:grid;gap:1rem;max-width:420px;margin-inline:auto">
        {{ form.errors | default_errors }}
        <label for="act-pass">Mot de passe</label>
        <input id="act-pass" type="password" name="customer[password]" required style="padding:.9rem;border:2px solid var(--color-border);border-radius:12px">
        <label for="act-confirm">Confirmer le mot de passe</label>
        <input id="act-confirm" type="password" name="customer[password_confirmation]" required style="padding:.9rem;border:2px solid var(--color-border);border-radius:12px">
        <button type="submit" class="btn">Activer mon compte</button>
        <button type="submit" name="decline" class="btn btn--outline">Refuser l'invitation</button>
      </div>
    {% endform %}
  </div>
</section>
