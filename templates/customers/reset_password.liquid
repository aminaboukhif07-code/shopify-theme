<section class="section">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">Réinitialiser le mot de passe</h1>
    {% form 'reset_customer_password' %}
      <div style="display:grid;gap:1rem;max-width:420px;margin-inline:auto">
        {{ form.errors | default_errors }}
        <label for="reset-pass">Nouveau mot de passe</label>
        <input id="reset-pass" type="password" name="customer[password]" required style="padding:.9rem;border:2px solid var(--color-border);border-radius:12px">
        <label for="reset-confirm">Confirmer le mot de passe</label>
        <input id="reset-confirm" type="password" name="customer[password_confirmation]" required style="padding:.9rem;border:2px solid var(--color-border);border-radius:12px">
        <button type="submit" class="btn">Réinitialiser</button>
      </div>
    {% endform %}
  </div>
</section>
