{%- comment -%}
  Guide des tailles Bettermoove — DA sauge.
  Bloc « Comment prendre votre mesure » + illustration (10 cm au-dessus du genou) + tableau.
{%- endcomment -%}
<section class="section sizeguide {% if section.settings.soft_bg %}section--soft{% endif %}">
  <div class="page-width">
    <div class="sizeguide__card">
      <div class="sizeguide__intro">
        <span class="sizeguide__icon">{% render 'icon', name: 'ruler' %}</span>
        <div class="sizeguide__intro-text">
          <h3 class="sizeguide__eyebrow">{{ section.settings.eyebrow }}</h3>
          <p>{{ section.settings.instruction }} {%- if section.settings.instruction_highlight != blank -%}<strong>{{ section.settings.instruction_highlight }}</strong>{%- endif -%}</p>
        </div>
      </div>

      <div class="sizeguide__cols">
        <div class="sizeguide__illus">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 440 | image_tag: class: 'sizeguide__illus-img', widths: '220,330,440', alt: 'Mesure à 10 cm au-dessus du genou' }}
          {%- else -%}
            <svg class="sizeguide__svg" viewBox="0 0 260 280" fill="none" role="img" aria-label="Mesurez à 10 cm au-dessus du genou">
              <path d="M70 264 C60 226 80 196 96 181 L186 80 C197 71 208 80 207 97 L132 187 C120 211 112 236 106 261 C96 270 80 271 70 264 Z" stroke="#2b2b2b" stroke-width="2.4" stroke-linejoin="round"/>
              <path d="M96 181 C108 178 122 180 132 187" stroke="#2b2b2b" stroke-width="2.4" stroke-linecap="round"/>
              <ellipse cx="175" cy="108" rx="10" ry="34" transform="rotate(-48 175 108)" stroke="#8FAF8A" stroke-width="6"/>
              <line x1="75" y1="161" x2="165" y2="61" stroke="#76976F" stroke-width="2.4" stroke-linecap="round"/>
              <line x1="69" y1="156" x2="81" y2="166" stroke="#76976F" stroke-width="2.4" stroke-linecap="round"/>
              <line x1="159" y1="56" x2="171" y2="66" stroke="#76976F" stroke-width="2.4" stroke-linecap="round"/>
              <text x="123" y="116" fill="#2b2b2b" font-size="19" font-weight="700" text-anchor="middle" transform="rotate(-48 123 116)" font-family="sans-serif">10 cm</text>
            </svg>
          {%- endif -%}
          <span class="sizeguide__illus-cap">Mesurez à 10 cm au-dessus du genou</span>
        </div>

        <div class="sizeguide__table" role="table">
          <div class="sizeguide__row sizeguide__row--head" role="row">
            <span role="columnheader">{{ section.settings.col1_label }}</span>
            <span role="columnheader">{{ section.settings.col2_label }}{%- if section.settings.col2_sub != blank -%}<small>{{ section.settings.col2_sub }}</small>{%- endif -%}</span>
          </div>
          {%- for block in section.blocks -%}
            <div class="sizeguide__row" role="row" {{ block.shopify_attributes }}>
              <span class="sizeguide__badge">{{ block.settings.label }}</span>
              <span class="sizeguide__measure">{{ block.settings.measure }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guide des tailles",
  "settings": [
    { "type": "checkbox", "id": "soft_bg", "label": "Fond doux", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Titre", "default": "Comment prendre votre mesure ?" },
    { "type": "text", "id": "instruction", "label": "Instruction", "default": "Mesurez le tour de votre cuisse" },
    { "type": "text", "id": "instruction_highlight", "label": "Partie en évidence", "default": "à 10 cm au-dessus du genou." },
    { "type": "image_picker", "id": "image", "label": "Illustration (sinon un schéma s'affiche)" },
    { "type": "text", "id": "col1_label", "label": "Colonne 1", "default": "Taille" },
    { "type": "text", "id": "col2_label", "label": "Colonne 2", "default": "Tour de cuisse" },
    { "type": "text", "id": "col2_sub", "label": "Colonne 2 — précision", "default": "(à 10 cm au-dessus du genou)" }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Taille",
      "settings": [
        { "type": "text", "id": "label", "label": "Taille", "default": "S" },
        { "type": "text", "id": "measure", "label": "Tour de cuisse", "default": "37 - 43 cm" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide des tailles",
      "blocks": [
        { "type": "size", "settings": { "label": "S", "measure": "37 - 43 cm" } },
        { "type": "size", "settings": { "label": "M", "measure": "43 - 48 cm" } },
        { "type": "size", "settings": { "label": "L", "measure": "48 - 53 cm" } },
        { "type": "size", "settings": { "label": "XL", "measure": "53 - 58 cm" } }
      ]
    }
  ]
}
{% endschema %}
