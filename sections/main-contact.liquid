<section class="section">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ page.title | default: 'Contactez-nous' }}</h1>
    {%- if page.content != blank -%}<div class="rte text-center" style="margin-bottom:2rem">{{ page.content }}</div>{%- endif -%}

    {% form 'contact', class: 'contact-form' %}
      {%- if form.posted_successfully? -%}
        <p class="field-success text-center">{{ 'templates.contact.form.success' | t }}</p>
      {%- endif -%}
      <div style="display:grid;gap:1rem;max-width:560px;margin-inline:auto">
        <div>
          <label for="contact-name">{{ 'templates.contact.form.name' | t }}</label>
          <input id="contact-name" type="text" name="contact[name]" required style="width:100%;padding:.9rem;border:2px solid var(--color-border);border-radius:12px">
        </div>
        <div>
          <label for="contact-email">{{ 'templates.contact.form.email' | t }}</label>
          <input id="contact-email" type="email" name="contact[email]" required style="width:100%;padding:.9rem;border:2px solid var(--color-border);border-radius:12px">
        </div>
        <div>
          <label for="contact-message">{{ 'templates.contact.form.message' | t }}</label>
          <textarea id="contact-message" name="contact[body]" rows="5" required style="width:100%;padding:.9rem;border:2px solid var(--color-border);border-radius:12px"></textarea>
        </div>
        <button type="submit" class="btn">{{ 'templates.contact.form.send' | t }}</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Contact" }
{% endschema %}
