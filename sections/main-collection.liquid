<section class="section">
  <div class="page-width">
    <div class="section-header">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination text-center mt-2" role="navigation">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--outline" style="width:auto">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--outline" style="width:auto">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="text-center">{{ 'sections.collection.empty' | t }}</p>
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Grille de collection",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 24, "step": 4, "label": "Produits par page", "default": 12 }
  ]
}
{% endschema %}
