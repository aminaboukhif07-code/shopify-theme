<section class="section">
  <div class="page-width">
    <h1 class="page-title">{{ blog.title }}</h1>
    <div class="product-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card">
          {%- if article.image -%}
            <div class="card__media">{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}</div>
          {%- endif -%}
          <div class="card__body">
            <span class="card__title">{{ article.title }}</span>
            <p style="opacity:.75;font-size:.9rem">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Blog" }
{% endschema %}
