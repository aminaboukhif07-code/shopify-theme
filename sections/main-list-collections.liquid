<section class="section">
  <div class="page-width">
    <h1 class="page-title">{{ section.settings.title | default: 'Nos collections' }}</h1>
    <div class="product-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="card">
          <div class="card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="card__body"><span class="card__title">{{ collection.title }}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liste des collections",
  "settings": [ { "type": "text", "id": "title", "label": "Titre", "default": "Nos collections" } ]
}
{% endschema %}
