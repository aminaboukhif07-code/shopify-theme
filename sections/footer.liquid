<footer class="footer" style="background: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="footer__grid">
      {%- comment -%} Marque / logo {%- endcomment -%}
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 520 | image_tag: class: 'footer__logo-img', alt: section.settings.brand_name, widths: '260,400,520' }}
        {%- else -%}
          <h3 class="footer__brandname">{{ section.settings.brand_name }}</h3>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
      </div>

      {%- comment -%} Liens rapides {%- endcomment -%}
      <div class="footer__col">
        <h4>{{ section.settings.links_title }}</h4>
        <ul>
          <li><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Politique de confidentialité</a></li>
          <li><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Conditions de service</a></li>
          <li><a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Politique d'expédition</a></li>
          <li><a href="{{ section.settings.legal_url | default: '/pages/mentions-legales' }}">Mentions légales</a></li>
          <li><a href="{{ section.settings.cgv_url | default: '/pages/conditions-generales-de-vente' }}">Conditions générales de vente</a></li>
          <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Politique de remboursement</a></li>
        </ul>
      </div>

      {%- comment -%} Service client {%- endcomment -%}
      <div class="footer__col">
        <h4>{{ section.settings.service_title }}</h4>
        <p>{{ section.settings.service_text }}</p>
      </div>
    </div>

    {%- comment -%} Réseaux sociaux {%- endcomment -%}
    <div class="footer__social footer__social--center">
      {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
    </div>

    {%- comment -%} Moyens de paiement {%- endcomment -%}
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="footer__payments">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom footer__bottom--center">
      <span>&copy; {{ 'now' | date: '%Y' }}, {{ section.settings.brand_name }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Couleur de fond", "default": "#1F4D3A" },
    { "type": "image_picker", "id": "logo", "label": "Logo (sinon le nom de marque s'affiche)" },
    { "type": "text", "id": "brand_name", "label": "Nom de la marque", "default": "Equivora" },
    { "type": "text", "id": "tagline", "label": "Slogan", "default": "Alléger. Apaiser. Libérer." },
    { "type": "header", "content": "Liens rapides" },
    { "type": "text", "id": "links_title", "label": "Titre", "default": "Liens rapides" },
    { "type": "url", "id": "legal_url", "label": "Lien « Mentions légales »" },
    { "type": "url", "id": "cgv_url", "label": "Lien « Conditions générales de vente »" },
    { "type": "header", "content": "Service client" },
    { "type": "text", "id": "service_title", "label": "Titre", "default": "Service client :" },
    { "type": "textarea", "id": "service_text", "label": "Texte", "default": "Nous sommes disponibles à l'adresse mail suivante : contact@equivora.fr" }
  ]
}
{% endschema %}
