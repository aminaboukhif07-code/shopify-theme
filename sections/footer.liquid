<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        <h3>{{ section.settings.heading | default: shop.name }}</h3>
        <p>{{ section.settings.about | default: "Des solutions de maintien pensées pour soulager vos articulations et retrouver le plaisir de bouger, jour après jour." }}</p>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        </div>
      </div>

      {%- if section.settings.menu_1 != blank -%}
        <div class="footer__col">
          <h4>{{ section.settings.menu_1_title }}</h4>
          <ul>
            {%- for link in section.settings.menu_1.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.menu_2 != blank -%}
        <div class="footer__col">
          <h4>{{ section.settings.menu_2_title }}</h4>
          <ul>
            {%- for link in section.settings.menu_2.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="footer__col" style="max-width:420px;margin-bottom:2rem">
        <h4>{{ section.settings.newsletter_title | default: "Recevez nos conseils & offres" }}</h4>
        {% form 'customer', class: 'newsletter__form', style: 'margin:0;justify-content:flex-start' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="footer-email">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
          <input id="footer-email" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required>
          <button type="submit" class="btn">{{ 'general.newsletter_form.submit' | t }}</button>
        {% endform %}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</span>
      <span>Paiement 100% sécurisé · Made with care 🌿</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre de la marque" },
    { "type": "textarea", "id": "about", "label": "À propos" },
    { "type": "header", "content": "Colonne 1" },
    { "type": "text", "id": "menu_1_title", "label": "Titre", "default": "Boutique" },
    { "type": "link_list", "id": "menu_1", "label": "Menu" },
    { "type": "header", "content": "Colonne 2" },
    { "type": "text", "id": "menu_2_title", "label": "Titre", "default": "Aide" },
    { "type": "link_list", "id": "menu_2", "label": "Menu" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Afficher l'inscription", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Titre newsletter" }
  ]
}
{% endschema %}
