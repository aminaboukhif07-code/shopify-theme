<h2>{{ section.settings.heading | default: 'Bientôt disponible' }}</h2>
<p>{{ section.settings.text | default: 'Notre boutique ouvre très bientôt. Laissez-nous votre e-mail pour être prévenu(e) en avant-première.' }}</p>

{% form 'storefront_password', class: 'newsletter__form', style: 'margin-top:1.5rem' %}
  <input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe">
  <button type="submit" class="btn">Entrer</button>
{% endform %}

{% schema %}
{
  "name": "Mot de passe",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "textarea", "id": "text", "label": "Texte" }
  ]
}
{% endschema %}
