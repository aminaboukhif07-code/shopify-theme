<section class="section {% if section.settings.soft_bg %}section--soft{% endif %}">
  <div class="page-width">
    <div class="split {% if section.settings.reverse %}split--reverse{% endif %}">
      <div class="split__content">
        {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul>
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check-circle' %} <span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: '#' }}" class="btn" style="width:auto;margin-top:1rem">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(max-width: 990px) 100vw, 50vw', loading: 'lazy', alt: section.settings.title }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image avec texte",
  "settings": [
    { "type": "checkbox", "id": "soft_bg", "label": "Fond doux", "default": false },
    { "type": "checkbox", "id": "reverse", "label": "Inverser (image à gauche)", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "La douleur ne devrait pas dicter votre quotidien" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Monter les escaliers, jardiner, jouer avec vos petits-enfants… Avec la BetterKnee, retrouvez ces gestes simples sans appréhension.</p>" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" }
  ],
  "blocks": [
    { "type": "point", "name": "Point clé", "settings": [ { "type": "text", "id": "text", "label": "Texte", "default": "Soulage les douleurs en quelques minutes" } ] }
  ],
  "presets": [
    {
      "name": "Image avec texte",
      "blocks": [
        { "type": "point", "settings": { "text": "Réduit la pression sur l'articulation du genou" } },
        { "type": "point", "settings": { "text": "Améliore la stabilité lors de la marche" } },
        { "type": "point", "settings": { "text": "Accompagne la rééducation et la prévention" } }
      ]
    }
  ]
}
{% endschema %}
