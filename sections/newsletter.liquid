<section class="section {% if section.settings.soft_bg %}section--soft{% endif %}">
  <div class="page-width page-width--narrow newsletter">
    {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="field-success">{{ 'general.newsletter_form.confirmation' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="newsletter-email">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
        <input id="newsletter-email" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required>
        <button type="submit" class="btn">{{ 'general.newsletter_form.submit' | t }}</button>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "checkbox", "id": "soft_bg", "label": "Fond doux", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "-10% sur votre 1ère commande" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Rejoignez la communauté Bettermoove" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Recevez nos conseils pour soulager vos articulations et profitez de -10% sur votre première commande." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
