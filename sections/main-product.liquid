{%- liquid
  assign product = product
  assign sizes = section.settings.sizes | default: 'S (37-43cm),M (43-48cm),L (48-53cm),XL (53-58cm)' | split: ','
  assign default_v = product.variants.first
  for v in product.variants
    assign n = v.option1 | split: ' ' | first | plus: 0
    if n == 2
      assign default_v = v
    endif
  endfor
-%}

<section class="section product-section" data-product-container>
  <div class="page-width">
    <div class="product">

      {%- comment -%} ----- Carrousel ----- {%- endcomment -%}
      <div class="product__media">
        <div class="gallery" data-carousel>
          <div class="gallery__track" data-carousel-track>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media limit: 8 -%}
                {%- assign img_loading = 'lazy' -%}
                {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- endif -%}
                <div class="gallery__slide">
                  {{ media | image_url: width: 1100 | image_tag: widths: '500,750,1100', sizes: '(max-width: 990px) 100vw, 50vw', loading: img_loading, alt: product.title }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="gallery__slide">{{ 'product-2' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="gallery__dots" data-carousel-dots>
              {%- for media in product.media limit: 8 -%}
                <button type="button" class="gallery__dot {% if forloop.first %}is-active{% endif %}" data-carousel-dot aria-label="Image {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ----- Infos & achat ----- {%- endcomment -%}
      <div class="product__info">

        <div class="product__head">
          {%- if product.vendor != blank and section.settings.show_vendor -%}
            <span class="product__vendor">{{ product.vendor }}</span>
          {%- endif -%}
          <h1 class="product__title">{{ product.title }}</h1>
          {%- if section.settings.show_rating -%}
            <div class="product__secure">
              <span class="product__secure-icon">{% render 'icon', name: 'shield' %}</span>
              <span>Paiement 100% sécurisé</span>
            </div>
          {%- endif -%}
        </div>

        <div class="product__pricing">
          <div class="product__price">
            <span class="price__current" data-price-current>{{ default_v.price | money }}</span>
            <span class="price__compare" data-price-compare{% unless default_v.compare_at_price > default_v.price %} hidden{% endunless %}>{{ default_v.compare_at_price | money }}</span>
            {%- if default_v.compare_at_price > default_v.price -%}
              <span class="price__badge" data-price-badge>-{{ default_v.compare_at_price | minus: default_v.price | times: 100 | divided_by: default_v.compare_at_price }}%</span>
            {%- else -%}
              <span class="price__badge" data-price-badge hidden></span>
            {%- endif -%}
          </div>
          <span class="product__save" data-price-save{% unless default_v.compare_at_price > default_v.price %} hidden{% endunless %}>Vous économisez {{ default_v.compare_at_price | minus: default_v.price | money }}</span>
          {%- if section.settings.instalment_text != blank -%}
            <span class="product__instalment">{{ section.settings.instalment_text }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.show_stock -%}
          <div class="product__stock" data-stock><span class="dot"></span> Plus que 25 en stock</div>
        {%- endif -%}

        {%- capture size_options -%}<option value="" disabled selected>Choisir la taille…</option>{%- for s in sizes -%}<option value="{{ s | strip }}">{{ s | strip }}</option>{%- endfor -%}{%- endcapture -%}

        {%- comment -%} ----- Formules ----- {%- endcomment -%}
        <div class="packs" data-bundles role="radiogroup" aria-label="Choisissez votre offre">
          {%- for v in product.variants -%}
            {%- assign qty = v.option1 | split: ' ' | first | plus: 0 -%}
            {%- assign is_default = false -%}
            {%- if v.id == default_v.id -%}{%- assign is_default = true -%}{%- endif -%}
            <div class="pack{% if qty == 1 %} pack--single{% endif %}{% if qty == 2 %} pack--featured{% endif %}{% if qty == 4 %} pack--best{% endif %}{% if is_default %} is-selected{% endif %}" data-bundle data-variant-id="{{ v.id }}" data-qty="{{ qty }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price | default: 0 }}" data-label="{{ v.title | escape }}" tabindex="0" role="radio" aria-checked="{% if is_default %}true{% else %}false{% endif %}">
              {%- if qty == 2 -%}<span class="pack__ribbon">Le + populaire</span>{%- endif -%}
              {%- if qty == 4 -%}<span class="pack__ribbon pack__ribbon--best">Meilleure offre</span>{%- endif -%}
              <div class="pack__head">
                <span class="pack__radio" aria-hidden="true"></span>
                <span class="pack__name">{{ v.title }}</span>
                {%- if v.compare_at_price > v.price -%}
                  <span class="pack__badge-save">Économisez {{ v.compare_at_price | minus: v.price | money }}</span>
                {%- endif -%}
                <span class="pack__prices"><b>{{ v.price | money }}</b>{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}</span>
              </div>
              <div class="pack__sizes" data-sizes{% unless is_default %} hidden{% endunless %}>
                <span class="pack__sizes-label">{% if qty == 1 %}Choisissez votre taille{% else %}Une taille par genouillère{% endif %}</span>
                {%- for i in (1..qty) -%}
                  <div class="pack__size-row">
                    <label class="visually-hidden" for="{{ section.id }}-{{ qty }}-{{ i }}">Taille genouillère {{ i }}</label>
                    <select id="{{ section.id }}-{{ qty }}-{{ i }}" data-size-select>{{ size_options }}</select>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="product__buy">
          {%- if section.settings.size_guide_page != blank -%}
            <a class="product__size-guide-link" href="{{ section.settings.size_guide_page.url }}">Guide des tailles</a>
          {%- endif -%}
          <button type="button" class="btn btn--large" data-bundle-add data-add-btn>
            <span class="loading-spinner"></span>
            <span class="btn__text">Ajouter au panier</span>
          </button>
          <div data-cart-error class="product__error" hidden></div>
          <div class="product__assur">
            <span>{% render 'icon', name: 'truck' %} Livraison offerte dès 59€</span>
            <span>{% render 'icon', name: 'return' %} 30 jours pour changer d'avis</span>
            <span>{% render 'icon', name: 'shield' %} Paiement 100% sécurisé</span>
          </div>
        </div>

        <figure class="pack-review">
          <span class="pack-review__stars">{% render 'stars', rating: 5 %}</span>
          <blockquote class="pack-review__text">Honnêtement, je les ai portées plusieurs jours et j’aime beaucoup. Le maintien est vraiment bon et confortable, et surtout elles ne glissent pas durant la journée, même quand je marche beaucoup. Elles sont très confortables et discrètes sous les vêtements. une très bonne surprise.</blockquote>
          <figcaption class="pack-review__name">Yesmine</figcaption>
        </figure>

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="payment-icons">
            {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product.description != blank -%}
          <details class="product__desc">
            <summary class="product__desc-summary">
              <span>{{ section.settings.desc_title | default: 'Description du produit' }}</span>
              <span class="product__desc-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="product__desc-body rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Barre d'ajout collante (mobile) {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__info">
    <div class="sticky-atc__title">{{ product.title }}</div>
    <div class="sticky-atc__price" data-sticky-price>{{ default_v.price | money }}</div>
  </div>
  <button type="button" class="btn" data-sticky-add>Ajouter</button>
</div>

<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "image": [{{ product.featured_media | image_url: width: 1000 | prepend: 'https:' | json }}],
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ product.price | divided_by: 100.0 }}",
    "availability": "{% if product.available %}http://schema.org/InStock{% else %}http://schema.org/OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  },
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "{{ section.settings.reviews_count }}" }
}
</script>

{% schema %}
{
  "name": "Page produit",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Afficher la marque", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Afficher la note", "default": true },
    { "type": "text", "id": "reviews_count", "label": "Nombre d'avis", "default": "2347" },
    { "type": "checkbox", "id": "show_stock", "label": "Afficher le stock", "default": true },
    { "type": "text", "id": "sizes", "label": "Tailles proposées (séparées par des virgules)", "default": "S (37-43cm),M (43-48cm),L (48-53cm),XL (53-58cm)" },
    { "type": "text", "id": "instalment_text", "label": "Texte sous le prix", "default": "Paiement 100% sécurisé · Livraison rapide" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Afficher les moyens de paiement", "default": true },
    { "type": "text", "id": "desc_title", "label": "Titre de la description repliable", "default": "Description du produit" },
    { "type": "page", "id": "size_guide_page", "label": "Page guide des tailles" }
  ],
  "blocks": [
    {
      "type": "reassurance", "name": "Réassurance",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retour" },
            { "value": "shield", "label": "Garantie" },
            { "value": "headset", "label": "Support" },
            { "value": "clock", "label": "Rapidité" },
            { "value": "check-circle", "label": "Validé" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 59€, livraison rapide" }
      ]
    }
  ]
}
{% endschema %}
