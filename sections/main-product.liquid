{%- liquid
  assign product = product
  assign sizes = section.settings.sizes | default: 'S,M,L,XL' | split: ','
  comment
    Variante affichée par défaut : la formule « 2 » si elle existe, sinon la première.
  endcomment
  assign default_v = product.variants.first
  for v in product.variants
    assign n = v.option1 | split: ' ' | first | plus: 0
    if n == 2
      assign default_v = v
    endif
  endfor
-%}

<section class="section" data-product-container>
  <div class="page-width">
    <div class="product">
      {%- comment -%} Galerie {%- endcomment -%}
      <div class="product__media" data-gallery>
        <div class="product__gallery-main" data-gallery-main>
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1000 | image_tag: widths: '500,750,1000', sizes: '(max-width: 990px) 100vw, 50vw', fetchpriority: 'high', alt: product.title }}
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media limit: 10 -%}
              <button type="button" class="product__thumb {% if forloop.first %}is-active{% endif %}" data-gallery-thumb data-full="{{ media | image_url: width: 1000 }}" aria-label="Image {{ forloop.index }}">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Infos & achat {%- endcomment -%}
      <div class="product__info">
        {%- if product.vendor != blank and section.settings.show_vendor -%}
          <div class="product__vendor">{{ product.vendor }}</div>
        {%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>

        {%- if section.settings.show_rating -%}
          <div class="product__rating">
            {% render 'stars', rating: 5 %}
            <a href="#avis">4,9/5 · {{ section.settings.reviews_count }} {{ 'sections.product.reviews' | t }}</a>
          </div>
        {%- endif -%}

        <div class="product__price">
          <span class="price__current" data-price-current>{{ default_v.price | money }}</span>
          <span class="price__compare" data-price-compare{% unless default_v.compare_at_price > default_v.price %} hidden{% endunless %}>{{ default_v.compare_at_price | money }}</span>
          {%- if default_v.compare_at_price > default_v.price -%}
            <span class="price__badge" data-price-badge>-{{ default_v.compare_at_price | minus: default_v.price | times: 100 | divided_by: default_v.compare_at_price }}%</span>
          {%- else -%}
            <span class="price__badge" data-price-badge hidden></span>
          {%- endif -%}
        </div>
        <p class="product__save" data-price-save{% unless default_v.compare_at_price > default_v.price %} hidden{% endunless %}>Vous économisez {{ default_v.compare_at_price | minus: default_v.price | money }}</p>

        {%- if section.settings.instalment_text != blank -%}
          <p class="product__instalment">{{ section.settings.instalment_text }}</p>
        {%- endif -%}

        {%- if section.settings.show_stock -%}
          <div class="product__stock" data-stock><span class="dot"></span> {{ 'sections.product.in_stock' | t }}</div>
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="product__description rte">{{ product.description }}</div>
        {%- endif -%}

        {%- comment -%} Options de taille réutilisables (placeholder + tailles) {%- endcomment -%}
        {%- capture size_options -%}<option value="" disabled selected>Choisir la taille…</option>{%- for s in sizes -%}<option value="{{ s | strip }}">{{ s | strip }}</option>{%- endfor -%}{%- endcapture -%}

        {%- comment -%} Sélecteur de formules — prix fixes {%- endcomment -%}
        <div class="packs" data-bundles role="radiogroup" aria-label="Choisissez votre offre">
          {%- for v in product.variants -%}
            {%- assign qty = v.option1 | split: ' ' | first | plus: 0 -%}
            {%- assign is_default = false -%}
            {%- if v.id == default_v.id -%}{%- assign is_default = true -%}{%- endif -%}
            <div class="pack{% if qty == 2 %} pack--featured{% endif %}{% if qty == 4 %} pack--best{% endif %}{% if is_default %} is-selected{% endif %}" data-bundle data-variant-id="{{ v.id }}" data-qty="{{ qty }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price | default: 0 }}" data-label="{{ v.title | escape }}" tabindex="0" role="radio" aria-checked="{% if is_default %}true{% else %}false{% endif %}">
              {%- if qty == 2 -%}<span class="pack__ribbon">Le + populaire</span>{%- endif -%}
              {%- if qty == 4 -%}<span class="pack__ribbon pack__ribbon--best">Meilleure offre</span>{%- endif -%}
              <div class="pack__head">
                <span class="pack__radio" aria-hidden="true"></span>
                <span class="pack__name">{{ v.title }}</span>
                {%- if v.compare_at_price > v.price -%}
                  <span class="pack__badge-save">Économisez {{ v.compare_at_price | minus: v.price | money }}</span>
                {%- else -%}
                  <span class="pack__badge-save">Pour essayer</span>
                {%- endif -%}
                <span class="pack__prices"><b>{{ v.price | money }}</b>{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}</span>
              </div>
              <div class="pack__sizes" data-sizes{% unless is_default %} hidden{% endunless %}>
                <span class="pack__sizes-label">{% if qty == 1 %}Choisissez votre taille{% else %}Une taille par genouillère{% endif %}</span>
                {%- for i in (1..qty) -%}
                  <div class="pack__size-row">
                    {%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">{%- endif -%}
                    <label class="visually-hidden" for="{{ section.id }}-{{ qty }}-{{ i }}">Taille genouillère {{ i }}</label>
                    <select id="{{ section.id }}-{{ qty }}-{{ i }}" data-size-select>{{ size_options }}</select>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.size_guide_page != blank -%}
          <a class="product__size-guide-link" href="{{ section.settings.size_guide_page.url }}">{{ 'sections.product.size_guide' | t }}</a>
        {%- endif -%}

        <div class="product__form-buttons">
          <button type="button" class="btn btn--large" data-bundle-add data-add-btn>
            <span class="loading-spinner"></span>
            <span class="btn__text">{{ 'sections.product.add_to_cart' | t }}</span>
          </button>
        </div>
        <div data-cart-error hidden style="color:#c0392b;font-weight:600;margin:.5rem 0 1rem"></div>

        {%- comment -%} Réassurance {%- endcomment -%}
        <ul class="product__reassurance">
          {%- for block in section.blocks -%}
            {%- if block.type == 'reassurance' -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %} <span>{{ block.settings.text }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.settings.show_payment_icons -%}
          <div>
            <p style="font-size:.85rem;opacity:.7;margin-bottom:.4rem">{% render 'icon', name: 'shield', class: 'icon-inline' %} Paiement 100% sécurisé</p>
            <div class="payment-icons">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'payment-icon' }}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Barre d'ajout collante (mobile) {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__info">
    <div class="sticky-atc__title">{{ product.title }}</div>
    <div class="sticky-atc__price" data-sticky-price>{{ default_v.price | money }}</div>
  </div>
  <button type="button" class="btn" data-sticky-add>{{ 'sections.product.add_to_cart' | t }}</button>
</div>

{%- comment -%} Données structurées SEO {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "image": [{{ product.featured_media | image_url: width: 1000 | prepend: 'https:' | json }}],
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ product.price | divided_by: 100.0 }}",
    "availability": "{% if product.available %}http://schema.org/InStock{% else %}http://schema.org/OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  },
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "{{ section.settings.reviews_count }}" }
}
</script>

{% schema %}
{
  "name": "Page produit",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Afficher la marque", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Afficher la note", "default": true },
    { "type": "text", "id": "reviews_count", "label": "Nombre d'avis", "default": "2347" },
    { "type": "checkbox", "id": "show_stock", "label": "Afficher le stock", "default": true },
    { "type": "text", "id": "sizes", "label": "Tailles proposées (séparées par des virgules)", "default": "S,M,L,XL" },
    { "type": "text", "id": "instalment_text", "label": "Texte sous le prix", "default": "Paiement 100% sécurisé · Livraison rapide" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Afficher les moyens de paiement", "default": true },
    { "type": "page", "id": "size_guide_page", "label": "Page guide des tailles" }
  ],
  "blocks": [
    {
      "type": "reassurance", "name": "Réassurance",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retour" },
            { "value": "shield", "label": "Garantie" },
            { "value": "headset", "label": "Support" },
            { "value": "clock", "label": "Rapidité" },
            { "value": "check-circle", "label": "Validé" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 59€, livraison rapide" }
      ]
    }
  ]
}
{% endschema %}
