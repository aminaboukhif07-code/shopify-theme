{%- comment -%}
  Comparateur morphologie — slider avant/après + sélecteur (Homme / Femme).
  Réutilise le composant .compare (JS data-compare) ; data-morpho gère le swap d'images.
{%- endcomment -%}
<section class="section morpho {% if section.settings.soft_bg %}section--soft{% endif %}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2>{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign first = section.blocks.first
      assign first_before = ''
      assign first_after = ''
      if first.settings.image_before != blank
        assign first_before = first.settings.image_before | image_url: width: 1400
      endif
      if first.settings.image_after != blank
        assign first_after = first.settings.image_after | image_url: width: 1400
      endif
    -%}

    <div class="morpho__wrap" data-morpho>
      <div
        class="compare"
        data-compare
        style="--pos: {{ section.settings.start_position }}%; --ratio: {{ section.settings.ratio }};"
        tabindex="0"
        role="slider"
        aria-label="Comparateur : faites glisser pour comparer"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ section.settings.start_position }}"
      >
        <div class="compare__layer compare__after">
          {%- if first_after != blank -%}
            <img src="{{ first_after }}" alt="{{ section.settings.label_after }}" data-morpho-after width="1400" height="1050">
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="compare__layer compare__before">
          {%- if first_before != blank -%}
            <img src="{{ first_before }}" alt="{{ section.settings.label_before }}" data-morpho-before width="1400" height="1050">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        <div class="compare__handle" data-compare-handle aria-hidden="true">
          <span class="compare__grip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="10 7 5 12 10 17"/><polyline points="14 7 19 12 14 17"/></svg>
          </span>
        </div>
      </div>

      <div class="morpho__select">
        {%- if section.settings.select_label != blank -%}<span class="morpho__select-label">{{ section.settings.select_label }}</span>{%- endif -%}
        <div class="morpho__options" role="tablist">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b_url = ''
              assign a_url = ''
              if block.settings.image_before != blank
                assign b_url = block.settings.image_before | image_url: width: 1400
              endif
              if block.settings.image_after != blank
                assign a_url = block.settings.image_after | image_url: width: 1400
              endif
            -%}
            <button
              type="button"
              class="morpho__btn{% if forloop.first %} is-active{% endif %}"
              data-morpho-tab="{{ forloop.index0 }}"
              data-before="{{ b_url }}"
              data-after="{{ a_url }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="morpho__btn-label">{{ block.settings.label }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparateur morphologie",
  "settings": [
    { "type": "checkbox", "id": "soft_bg", "label": "Fond doux", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Pensée pour toutes les morphologies" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Un maintien qui s'adapte à vous" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Glissez le curseur pour voir la différence." },
    { "type": "text", "id": "label_before", "label": "Étiquette gauche", "default": "Avant" },
    { "type": "text", "id": "label_after", "label": "Étiquette droite", "default": "Après" },
    { "type": "text", "id": "select_label", "label": "Libellé du sélecteur", "default": "Vous êtes :" },
    {
      "type": "select", "id": "ratio", "label": "Format de l'image",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Carré (1:1)" },
        { "value": "4 / 3", "label": "Paysage (4:3)" },
        { "value": "16 / 10", "label": "Large (16:10)" }
      ],
      "default": "4 / 3"
    },
    { "type": "range", "id": "start_position", "min": 10, "max": 90, "step": 5, "unit": "%", "label": "Position de départ du curseur", "default": 50 }
  ],
  "blocks": [
    {
      "type": "profile",
      "name": "Profil",
      "settings": [
        { "type": "text", "id": "label", "label": "Nom du profil", "default": "Homme" },
        { "type": "image_picker", "id": "image_before", "label": "Image avant (gauche)" },
        { "type": "image_picker", "id": "image_after", "label": "Image après (droite)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Comparateur morphologie",
      "blocks": [
        { "type": "profile", "settings": { "label": "Homme" } },
        { "type": "profile", "settings": { "label": "Femme" } }
      ]
    }
  ]
}
{% endschema %}
