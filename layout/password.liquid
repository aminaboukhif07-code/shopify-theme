<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.font_heading -%}{{ settings.font_heading | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if settings.font_body -%}{{ settings.font_body | font_face: font_display: 'swap' }}{%- endif -%}
    <title>{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {%- liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading
    -%}
    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-cta: {{ settings.color_cta }};
        --color-cta-text: {{ settings.color_cta_text }};
        --color-cta-hover: {{ settings.color_cta_hover }};
        --color-soft: {{ settings.color_soft }};
        --color-border: {{ settings.color_border }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-size-base: {{ settings.font_size_base }}px;
        --button-radius: {{ settings.button_radius }}px;
        --card-radius: {{ settings.card_radius }}px;
        --page-width: {{ settings.page_width }}px;
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main class="password-page">
      <div class="password-page__inner">
        {%- if section.settings.logo == blank -%}
          <h1 class="password-page__logo">{{ shop.name }}</h1>
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
        {% section 'main-password' %}
      </div>
    </main>
  </body>
</html>
