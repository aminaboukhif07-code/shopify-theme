{%- comment -%} Affiche 5 étoiles. Usage : {% render 'stars', rating: 5 %} {%- endcomment -%}
{%- assign r = rating | default: 5 -%}
<span class="stars" role="img" aria-label="{{ 'accessibility.star_reviews' | t: rating: r }}">
  {%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
</span>
